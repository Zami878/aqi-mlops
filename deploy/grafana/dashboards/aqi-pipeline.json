    {
      "id": 5,
      "type": "stat",
      "title": "Monitor decision",
      "description": "healthy = keep champion; retrain = lost skill or model too old; blocked = sensor fault, retraining refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "aqi_monitor_decision == 1",
          "legendFormat": "{{decision}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5470c6",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "healthy": {
                  "text": "Healthy",
                  "color": "#00b050"
                },
                "retrain": {
                  "text": "Retrain",
                  "color": "#ff9900"
                },
                "blocked_sensor_fault": {
                  "text": "Blocked: sensor fault",
                  "color": "#ff0000"
