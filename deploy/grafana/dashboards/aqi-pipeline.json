{
  "uid": "aqi-pipeline",
  "title": "AQI MLOps pipeline (Delhi)",
  "tags": [
    "aqi",
    "mlops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Forecast (Delhi, next day, CPCB AQI)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Next-day AQI forecast",
      "description": "Champion model's forecast for tomorrow, coloured by CPCB category.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "aqi_forecast",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00b050",
                "value": null
              },
              {
                "color": "#92d050",
                "value": 51
              },
              {
                "color": "#e6c000",
                "value": 101
              },
              {
                "color": "#ff9900",
                "value": 201
              },
              {
                "color": "#ff0000",
                "value": 301
              },
              {
                "color": "#9e1e1e",
                "value": 401
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
