      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (path) (rate(aqi_requests_total[1m]))",
          "legendFormat": "{{path}}",
          "instant": false,
          "range": true
