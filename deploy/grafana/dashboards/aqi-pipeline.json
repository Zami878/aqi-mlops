    {
      "id": 19,
      "type": "stat",
      "title": "Skill vs persistence, recent unseen days",
      "description": "100 x (1 - champion MAE / persistence MAE) on the last 30 days the champion was not trained on. Above 0 = better than 'tomorrow = today'; at or below 0 the AqiModelLostSkill alert fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "expr": "100 * (1 - aqi_recent_mae{model=\"champion\"} / ignoring(model) aqi_recent_mae{model=\"persistence\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
